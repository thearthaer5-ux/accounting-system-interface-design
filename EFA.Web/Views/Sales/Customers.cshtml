@model List<EFA.Application.DTOs.CustomerDto>

@{
    ViewData["Title"] = "العملاء";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>إدارة العملاء</h2>
        </div>
        <div class="col-md-4 text-end">
            <a href="/Sales/CreateCustomer" class="btn btn-primary">إضافة عميل جديد</a>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <input type="text" class="form-control" placeholder="البحث عن عميل...">
        </div>
        <div class="col-md-2">
            <button class="btn btn-outline-secondary">بحث</button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-striped">
            <thead class="table-dark">
                <tr>
                    <th>رمز العميل</th>
                    <th>اسم العميل</th>
                    <th>الهاتف</th>
                    <th>البريد الإلكتروني</th>
                    <th>الحد الائتماني</th>
                    <th>الحالة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model)
                {
                    <tr>
                        <td>@customer.CustomerCode</td>
                        <td>@customer.CustomerNameAr</td>
                        <td>@customer.PhoneNumber</td>
                        <td>@customer.Email</td>
                        <td>@customer.CreditLimit.ToString("C")</td>
                        <td>
                            <span class="badge @(customer.IsActive ? "bg-success" : "bg-danger")">
                                @(customer.IsActive ? "نشط" : "معطل")
                            </span>
                        </td>
                        <td>
                            <a href="/Sales/Customer/@customer.CustomerId" class="btn btn-sm btn-info">عرض</a>
                            <a href="#" class="btn btn-sm btn-warning">تعديل</a>
                            <a href="#" class="btn btn-sm btn-danger">حذف</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
