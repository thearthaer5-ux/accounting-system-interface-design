@model List<EFA.Application.DTOs.SalesReturnDto>

@{
    ViewData["Title"] = "مرتجعات المبيعات";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>مرتجعات المبيعات</h2>
        </div>
        <div class="col-md-4 text-end">
            <a href="/Sales/CreateReturn" class="btn btn-primary">إضافة مرتجع جديد</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-striped">
            <thead class="table-dark">
                <tr>
                    <th>رقم المرتجع</th>
                    <th>العميل</th>
                    <th>تاريخ المرتجع</th>
                    <th>السبب</th>
                    <th>المجموع</th>
                    <th>الحالة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var return in Model)
                {
                    <tr>
                        <td>@return.ReturnNumber</td>
                        <td>@return.CustomerName</td>
                        <td>@return.ReturnDate.ToString("dd/MM/yyyy")</td>
                        <td>@return.Reason</td>
                        <td>@return.TotalAmount.ToString("C")</td>
                        <td>
                            <span class="badge @(return.Status == "Approved" ? "bg-success" : "bg-warning")">
                                @return.Status
                            </span>
                        </td>
                        <td>
                            <a href="/Sales/Return/@return.SalesReturnId" class="btn btn-sm btn-info">عرض</a>
                            <a href="#" class="btn btn-sm btn-success">طباعة</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
