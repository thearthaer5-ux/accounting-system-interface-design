@model List<EFA.Application.DTOs.SalesOrderDto>

@{
    ViewData["Title"] = "أوامر البيع";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>أوامر البيع</h2>
        </div>
        <div class="col-md-4 text-end">
            <a href="/Sales/CreateOrder" class="btn btn-primary">إضافة أمر جديد</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-striped">
            <thead class="table-dark">
                <tr>
                    <th>رقم الأمر</th>
                    <th>العميل</th>
                    <th>تاريخ الأمر</th>
                    <th>الحالة</th>
                    <th>المجموع</th>
                    <th>المندوب</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.SalesOrderNumber</td>
                        <td>@order.CustomerName</td>
                        <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="badge bg-primary">@order.OrderStatus</span>
                        </td>
                        <td>@order.TotalAmount.ToString("C")</td>
                        <td>@order.SalesmanName</td>
                        <td>
                            <a href="/Sales/Order/@order.SalesOrderId" class="btn btn-sm btn-info">عرض</a>
                            <a href="#" class="btn btn-sm btn-primary">فاتورة</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
