@model List<WarehouseDto>

@{
    ViewData["Title"] = "إدارة المستودعات";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1 class="page-title">إدارة المستودعات</h1>
        </div>
        <div class="col-md-6 text-end">
            <a href="@Url.Action("Create")" class="btn btn-primary">
                <i class="fas fa-plus"></i> مستودع جديد
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">قائمة المستودعات</h5>
        </div>
        <div class="card-body">
            @if (Model.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>الاسم</th>
                                <th>الفرع</th>
                                <th>العنوان</th>
                                <th>المدير</th>
                                <th>السعة</th>
                                <th>رئيسي</th>
                                <th>الحالة</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var warehouse in Model)
                            {
                                <tr>
                                    <td>@warehouse.WarehouseNameAr</td>
                                    <td>@warehouse.BranchName</td>
                                    <td>@warehouse.WarehouseAddress</td>
                                    <td>@warehouse.WarehouseManager</td>
                                    <td>@warehouse.WarehouseCapacity</td>
                                    <td>
                                        @if (warehouse.IsMain)
                                        {
                                            <span class="badge bg-success">نعم</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">لا</span>
                                        }
                                    </td>
                                    <td>
                                        @if (warehouse.IsActive)
                                        {
                                            <span class="badge bg-primary">نشط</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">معطل</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Summary", new { id = warehouse.WarehouseId })" class="btn btn-sm btn-info" title="الملخص">
                                            <i class="fas fa-chart-bar"></i>
                                        </a>
                                        <a href="@Url.Action("Edit", new { id = warehouse.WarehouseId })" class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    <i class="fas fa-info-circle"></i> لا توجد مستودعات متاحة
                </div>
            }
        </div>
    </div>
</div>

<style>
    .page-title {
        font-size: 2rem;
        font-weight: bold;
        color: #2c3e50;
    }
</style>
