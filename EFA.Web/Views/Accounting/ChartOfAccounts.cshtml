@model IEnumerable<ChartOfAccountDto>

@{
    ViewData["Title"] = "شجرة الحسابات";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="h3 d-flex align-items-center">
                <i class="fas fa-sitemap text-primary me-2"></i>
                @ViewData["Title"]
            </h1>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("CreateAccount")" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>حساب جديد
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-light">
            <div class="row g-3">
                <div class="col-md-4">
                    <input type="text" id="searchBox" class="form-control" placeholder="ابحث عن حساب...">
                </div>
                <div class="col-md-4">
                    <select id="typeFilter" class="form-select">
                        <option value="">جميع الأنواع</option>
                        <option value="Asset">الأصول</option>
                        <option value="Liability">الالتزامات</option>
                        <option value="Equity">حقوق الملكية</option>
                        <option value="Income">الإيرادات</option>
                        <option value="Expense">المصروفات</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>رقم الحساب</th>
                            <th>اسم الحساب</th>
                            <th>النوع</th>
                            <th>المستوى</th>
                            <th>الحالة</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-info">@account.AccountNumber</span>
                                </td>
                                <td>@account.AccountNameAr</td>
                                <td>
                                    <span class="badge @GetAccountTypeBadgeClass(account.AccountType)">
                                        @GetAccountTypeDisplay(account.AccountType)
                                    </span>
                                </td>
                                <td>@account.AccountLevel</td>
                                <td>
                                    @if (account.IsActive)
                                    {
                                        <span class="badge bg-success">مفعل</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">معطل</span>
                                    }
                                </td>
                                <td>
                                    <a href="@Url.Action("AccountDetails", new { id = account.AccountId })" class="btn btn-sm btn-info" title="عرض">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#searchBox').on('keyup', function() {
                var searchValue = $(this).val().toLowerCase();
                $('table tbody tr').filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(searchValue) > -1)
                });
            });

            $('#typeFilter').on('change', function() {
                var typeValue = $(this).val();
                if (typeValue === '') {
                    $('table tbody tr').show();
                } else {
                    $('table tbody tr').filter(function() {
                        $(this).toggle($(this).find('td:eq(2)').text().includes(typeValue))
                    });
                }
            });
        });
    </script>
}

@functions {
    private string GetAccountTypeBadgeClass(string accountType)
    {
        return accountType switch
        {
            "Asset" => "bg-primary",
            "Liability" => "bg-warning",
            "Equity" => "bg-success",
            "Income" => "bg-info",
            "Expense" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private string GetAccountTypeDisplay(string accountType)
    {
        return accountType switch
        {
            "Asset" => "أصول",
            "Liability" => "التزامات",
            "Equity" => "حقوق ملكية",
            "Income" => "إيرادات",
            "Expense" => "مصروفات",
            _ => accountType
        };
    }
}
