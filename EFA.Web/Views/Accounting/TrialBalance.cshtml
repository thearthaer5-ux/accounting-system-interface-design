@model TrialBalanceReportDto

@{
    ViewData["Title"] = "ميزان المراجعة";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1 class="h3 d-flex align-items-center">
                <i class="fas fa-balance-scale text-primary me-2"></i>
                @ViewData["Title"]
            </h1>
        </div>
        <div class="col-md-6 text-end">
            <div class="btn-group">
                <button type="button" class="btn btn-outline-primary" onclick="window.print()">
                    <i class="fas fa-print me-2"></i>طباعة
                </button>
                <button type="button" class="btn btn-outline-success" onclick="exportToExcel()">
                    <i class="fas fa-download me-2"></i>تحميل
                </button>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-light">
            <div class="row">
                <div class="col-md-6">
                    <h5>الفترة: @Model.PeriodName</h5>
                </div>
                <div class="col-md-6 text-end">
                    <p class="text-muted mb-0">تاريخ التوليد: @Model.GeneratedDate.ToString("yyyy-MM-dd HH:mm")</p>
                </div>
            </div>
            @if (Model.IsBalanced)
            {
                <div class="alert alert-success mb-0 mt-3">
                    <i class="fas fa-check-circle me-2"></i>ميزان المراجعة متوازن
                </div>
            }
            else
            {
                <div class="alert alert-danger mb-0 mt-3">
                    <i class="fas fa-exclamation-circle me-2"></i>ميزان المراجعة غير متوازن - الفرق: @(Math.Abs(Model.TotalDebit - Model.TotalCredit).ToString("N2"))
                </div>
            }
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-sm mb-0" id="trialBalanceTable">
                    <thead class="table-light">
                        <tr>
                            <th class="col-3">رقم الحساب</th>
                            <th class="col-3">اسم الحساب</th>
                            <th class="col-1">نوع الحساب</th>
                            <th class="col-2 text-end">المدين</th>
                            <th class="col-2 text-end">الدائن</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var balance in Model.Balances)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-info">@balance.AccountNumber</span>
                                </td>
                                <td>@balance.AccountName</td>
                                <td>
                                    <span class="badge @GetAccountTypeBadgeClass(balance.AccountType)">
                                        @GetAccountTypeDisplay(balance.AccountType)
                                    </span>
                                </td>
                                <td class="text-end text-success fw-bold">
                                    @if (balance.DebitAmount > 0)
                                    {
                                        @balance.DebitAmount.ToString("N2")
                                    }
                                </td>
                                <td class="text-end text-danger fw-bold">
                                    @if (balance.CreditAmount > 0)
                                    {
                                        @balance.CreditAmount.ToString("N2")
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-light fw-bold">
                            <td colspan="3">الإجمالي</td>
                            <td class="text-end text-success">@Model.TotalDebit.ToString("N2")</td>
                            <td class="text-end text-danger">@Model.TotalCredit.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function exportToExcel() {
            var table = document.getElementById("trialBalanceTable");
            var workbook = XLSX.utils.table_to_book(table);
            XLSX.writeFile(workbook, "ميزان_المراجعة.xlsx");
        }
    </script>
}

@functions {
    private string GetAccountTypeBadgeClass(string accountType)
    {
        return accountType switch
        {
            "Asset" => "bg-primary",
            "Liability" => "bg-warning",
            "Equity" => "bg-success",
            "Income" => "bg-info",
            "Expense" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private string GetAccountTypeDisplay(string accountType)
    {
        return accountType switch
        {
            "Asset" => "أصول",
            "Liability" => "التزامات",
            "Equity" => "حقوق ملكية",
            "Income" => "إيرادات",
            "Expense" => "مصروفات",
            _ => accountType
        };
    }
}
