@model EFA.Application.DTOs.PaginatedResponseDto<EFA.Application.DTOs.UserDto>

@{
    ViewData["Title"] = "إدارة المستخدمين";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h1>إدارة المستخدمين</h1>
    </div>
    <div class="col-md-4 text-end">
        <a class="btn btn-primary" asp-action="Create">
            <i class="bi bi-plus-circle"></i> إضافة مستخدم جديد
        </a>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover table-striped mb-0">
            <thead class="table-light">
                <tr>
                    <th>اسم المستخدم</th>
                    <th>البريد الإلكتروني</th>
                    <th>الاسم الكامل</th>
                    <th>المجموعة</th>
                    <th>الفرع</th>
                    <th>الحالة</th>
                    <th>آخر دخول</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var user in Model.Items)
                    {
                        <tr>
                            <td>
                                <strong>@user.Username</strong>
                            </td>
                            <td>@user.Email</td>
                            <td>@(user.FullName ?? "---")</td>
                            <td>@(user.GroupName ?? "---")</td>
                            <td>@(user.BranchName ?? "---")</td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">نشط</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">معطل</span>
                                }
                            </td>
                            <td>
                                @if (user.LastLoginDate.HasValue)
                                {
                                    @user.LastLoginDate.Value.ToString("dd/MM/yyyy HH:mm")
                                }
                                else
                                {
                                    <span class="text-muted">لم يسجل دخول</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a class="btn btn-info" asp-action="Details" asp-route-id="@user.UserId" title="عرض">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@user.UserId" title="تعديل">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (user.IsActive)
                                    {
                                        <form asp-action="Deactivate" asp-route-id="@user.UserId" method="post" style="display:inline;" onsubmit="return confirm('هل تريد تعطيل هذا المستخدم؟');">
                                            <button type="submit" class="btn btn-danger" title="تعطيل">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Activate" asp-route-id="@user.UserId" method="post" style="display:inline;" onsubmit="return confirm('هل تريد تفعيل هذا المستخدم؟');">
                                            <button type="submit" class="btn btn-success" title="تفعيل">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            لا توجد مستخدمين حتى الآن
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            @if (Model.PageNumber > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="1">الأولى</a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)">السابقة</a>
                </li>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                if (i >= Model.PageNumber - 2 && i <= Model.PageNumber + 2)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@i">@i</a>
                    </li>
                }
            }

            @if (Model.PageNumber < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)">التالية</a>
                </li>
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@Model.TotalPages">الأخيرة</a>
                </li>
            }
        </ul>
    </nav>
}

<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }

    .btn-group-sm {
        margin-right: 5px;
    }
</style>
