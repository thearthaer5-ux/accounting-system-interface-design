@model List<EFA.Application.DTOs.PurchaseOrderDto>

@{
    ViewData["Title"] = "أوامر الشراء";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>أوامر الشراء المعلقة</h2>
        </div>
        <div class="col-md-4 text-end">
            <a href="#" class="btn btn-primary">
                <i class="fas fa-plus"></i> أمر شراء جديد
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            @if (Model?.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>رقم الأمر</th>
                                <th>الموردين</th>
                                <th>تاريخ الأمر</th>
                                <th>الحالة</th>
                                <th>المبلغ الكلي</th>
                                <th>نسبة الاستقبال</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td><strong>@order.PurchaseOrderNumber</strong></td>
                                    <td>@order.VendorName</td>
                                    <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="badge bg-warning">@order.Status</span>
                                    </td>
                                    <td>@order.TotalAmount.ToString("N2")</td>
                                    <td>
                                        <div class="progress" style="height: 20px;">
                                            <div class="progress-bar" style="width: @(order.ReceivedQuantityPercent)%">
                                                @(order.ReceivedQuantityPercent)%
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("PurchaseOrderDetails", new { id = order.PurchaseOrderId })" 
                                           class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    لا توجد أوامر شراء معلقة
                </div>
            }
        </div>
    </div>
</div>
